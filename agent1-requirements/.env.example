# Agent 1 - Requirement Gathering (port 8001)
# Copy this file to ".env" in this folder and fill in your own values.
# Never commit .env (it is already in .gitignore).

# Gemini API key, free from https://aistudio.google.com/apikey
# Use your own key: each key has its own daily quota.
GEMINI_API_KEY=your-gemini-api-key

# PostgreSQL database shared by agents 1, 2 and 3 (use the SAME value in all three).
# Create an empty database first, e.g. in psql:  CREATE DATABASE interior_design;
# The agents create their own tables on first start.
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/interior_design

# Login tokens. Must be IDENTICAL in agent1-requirements/.env and agent2-design/.env.
# Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-a-long-random-string
# How long a login lasts before the user must log in again (168 hours = 7 days)
AUTH_TOKEN_TTL_HOURS=168

# --- Optional Gemini tuning (defaults shown) ---
# Models to try in order; the next one is used when a model is busy (503) or out of quota (429)
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# Timeout for one Gemini request, in milliseconds
# GEMINI_TIMEOUT_MS=30000
# Give up on a request after this many seconds across all models and retries
# GEMINI_TOTAL_BUDGET_S=60

# --- Optional: where Agent 3 runs (used to check items/colours while chatting) ---
# AGENT3_URL=http://127.0.0.1:8003
